---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// 1. 从 Markdown 文件集合中读取所有期
const allMagazines = await getCollection('magazines');

// 2. 按日期倒序排列（最新的在最前）
const magazines = allMagazines.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// 3. 分离出最新一期（用于 Hero 展示）
const [latest, ...rest] = magazines;
---

<BaseLayout title="我的杂志 · 首页">
  <style>
    /* ===== 最新一期 Hero ===== */
    .hero {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 32px;
      background: #fff;
      padding: 28px;
      border: 1px solid #e5e3dd;
      box-shadow: 0 2px 12px rgba(0,0,0,0.04);
      margin-bottom: 48px;
    }
    .hero img {
      width: 100%;
      height: auto;
      display: block;
      border: 1px solid #ddd;
    }
    .hero .label {
      font-size: 0.7rem;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #c0392b;
      font-weight: 700;
      margin: 0 0 8px;
    }
    .hero h2 {
      font-size: 1.9rem;
      margin: 0 0 10px;
      line-height: 1.25;
    }
    .hero .date {
      color: #888;
      font-size: 0.85rem;
      margin: 0 0 14px;
    }
    .hero .desc {
      font-size: 1rem;
      color: #444;
      margin: 0 0 18px;
    }
    .hero ul {
      list-style: none;
      padding: 0;
      margin: 0 0 20px;
      border-top: 1px solid #eee;
      padding-top: 14px;
    }
    .hero ul li {
      font-size: 0.92rem;
      padding: 3px 0;
    }
    .hero ul li .author {
      color: #888;
      font-style: italic;
    }
    .btn {
      display: inline-block;
      padding: 10px 22px;
      background: #111;
      color: #fff;
      font-size: 0.85rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      border-radius: 2px;
      transition: background 0.2s;
    }
    .btn:hover {
      background: #c0392b;
      text-decoration: none;
    }

    /* ===== 往期列表 ===== */
    .section-title {
      font-size: 0.8rem;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #888;
      border-bottom: 1px solid #ddd;
      padding-bottom: 10px;
      margin: 0 0 24px;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 28px;
    }
    .card {
      background: #fff;
      border: 1px solid #e5e3dd;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .card:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    }
    .card img {
      width: 100%;
      display: block;
      border-bottom: 1px solid #eee;
    }
    .card .body {
      padding: 16px;
    }
    .card h3 {
      margin: 0 0 6px;
      font-size: 1.1rem;
      line-height: 1.3;
    }
    .card .date {
      font-size: 0.78rem;
      color: #888;
      margin: 0 0 10px;
    }
    .card .desc {
      font-size: 0.85rem;
      color: #555;
      margin: 0;
    }

    /* ===== 响应式 ===== */
    @media (max-width: 640px) {
      .hero { grid-template-columns: 1fr; }
      .hero img { max-width: 220px; margin: 0 auto; }
    }
  </style>

  {latest && (
    <section class="hero">
      <a href={`/magazine/${latest.slug}/`}>
        <img src={latest.data.cover} alt={latest.data.title} />
      </a>
      <div>
        <p class="label">最新一期</p>
        <h2>
          <a href={`/magazine/${latest.slug}/`} style="color:#111;">
            {latest.data.title}
          </a>
        </h2>
        <p class="date">
          {latest.data.date.toLocaleDateString('zh-CN', {
            year: 'numeric', month: 'long', day: 'numeric'
          })}
        </p>
        <p class="desc">{latest.data.description}</p>

        <ul>
          {latest.data.articles.map((article) => (
            <li>
              《{article.title}》 — <span class="author">{article.author}</span>
            </li>
          ))}
        </ul>

        <a href={`/magazine/${latest.slug}/`} class="btn">阅读本期</a>
      </div>
    </section>
  )}

  <h2 class="section-title">往期回顾</h2>

  <div class="grid">
    {rest.map((mag) => (
      <article class="card">
        <a href={`/magazine/${mag.slug}/`}>
          <img src={mag.data.cover} alt={mag.data.title} />
        </a>
        <div class="body">
          <h3>
            <a href={`/magazine/${mag.slug}/`} style="color:#111;">
              {mag.data.title}
            </a>
          </h3>
          <p class="date">
            {mag.data.date.toLocaleDateString('zh-CN', {
              year: 'numeric', month: 'long'
            })}
          </p>
          <p class="desc">{mag.data.description}</p>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>